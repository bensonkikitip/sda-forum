# Supabase — find these in your Supabase project under Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Your site's public URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email address auto-promoted to admin on first sign-in
ADMIN_EMAIL=you@example.com

# SMTP — used for notification and digest emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@example.com

# Random secret for the notification webhook — generate with: openssl rand -hex 32
NOTIFICATION_WEBHOOK_SECRET=your-random-secret
